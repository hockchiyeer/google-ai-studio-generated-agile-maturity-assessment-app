# Dependencies
node_modules/

# Build and coverage output
dist/
coverage/
.cache/
tmp/
temp/

# Local app persistence / linked exports
/data.json
/agile-maturity-linked.json
/agile-maturity-*.json

# Environment files
.env
.env.*
!.env.example

# Logs
*.log
